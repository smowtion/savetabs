{
  "name": "savetabs",
  "version": "0.1.0",
  "private": true,
  "description": "SaveTabs — browser extension and E2EE sync backend monorepo",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "test:scripts": "node --test scripts/verify-csp.test.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "build:ext": "pnpm --filter @savetabs/extension build",
    "icons": "pnpm --filter @savetabs/extension icons",
    "zip:chrome": "pnpm --filter @savetabs/extension zip:chrome",
    "zip:firefox": "pnpm --filter @savetabs/extension zip:firefox",
    "verify:build": "pnpm --filter @savetabs/extension verify:build",
    "dev:worker": "pnpm --filter @savetabs/worker dev",
    "db:migrate:local": "pnpm --filter @savetabs/worker db:migrate:local"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
