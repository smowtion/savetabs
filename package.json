{
  "name": "savetabs",
  "version": "0.1.0",
  "private": true,
  "description": "SaveTabs — browser extension and E2EE sync backend monorepo",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "build:ext": "pnpm --filter @savetabs/extension build"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
