# SaveTabs environment variables - names and placeholders only.
#
# Never commit real credentials. `.env*` is gitignored except this file.
# CI and the release workflow read these from GitHub repository variables and
# secrets (see README); a local `.env` file is not read by GitHub Actions.

# --- Extension build (WXT) ---
# Sync API origin injected into the manifest host permissions and runtime.
WXT_SAVETABS_API_BASE=https://api.savetabs.example
# Static release manifest for the daily update check. Defaults to the Pages
# origin; override only for a different static host.
# WXT_SAVETABS_VERSION_URL=https://savetabs.azcom.dev/versions.json
# Legacy alias accepted by apps/extension/wxt.config.ts. Empty values count as
# unset; WXT_SAVETABS_API_BASE wins when both are present.
# SAVETABS_API_BASE=https://api.savetabs.example

# --- Web build (Vite) ---
# Must be the same origin as WXT_SAVETABS_API_BASE. The release guard
# (scripts/verify-csp.mjs) fails unless the matching origin also appears in the
# built apps/web/dist/_headers connect-src. Update that file (or generate it)
# when the real API domain is registered.
VITE_API_BASE=https://api.savetabs.example

# --- Release scripts (scripts/update-versions.mjs) ---
# Read by CI and Release. Optional. Defaults to
# https://savetabs.pages.dev/releases/<version>.
SAVETABS_NOTES_URL=https://savetabs.pages.dev/releases/0.1.0

# --- Worker runtime vars ---
# Source of truth is apps/worker/wrangler.toml [vars]; listed for reference.
WEB_ORIGIN=https://savetabs.pages.dev
GLOBAL_MAX_KEYS=50000

# --- Cloudflare deploy (GitHub Actions secrets; leave empty locally) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Browser store submission (GitHub Actions secrets; leave empty locally) ---
# Chrome submission requires all four Chrome values; Firefox submission
# requires all three Firefox values. A partial tuple fails the release.
CHROME_EXTENSION_ID=
CHROME_PUBLISHER_ID=
CHROME_SERVICE_ACCOUNT_EMAIL=
# PEM private key from the service-account JSON. Store as a GitHub secret;
# never commit the real key.
CHROME_SERVICE_ACCOUNT_PRIVATE_KEY=
# Must equal browser_specific_settings.gecko.id in apps/extension/wxt.config.ts.
FIREFOX_EXTENSION_ID=
FIREFOX_JWT_ISSUER=
FIREFOX_JWT_SECRET=
