# SaveTabs environment variables - names and placeholders only.
#
# Never commit real credentials. `.env*` is gitignored except this file.
# CI and the release workflow read these from GitHub repository variables and
# secrets (see README); a local `.env` file is not read by GitHub Actions.

# --- Extension build (WXT) ---
# Sync API origin injected into the manifest host permissions and runtime.
WXT_SAVETABS_API_BASE=https://api.savetabs.example
# Legacy alias accepted by apps/extension/wxt.config.ts. Empty values count as
# unset; WXT_SAVETABS_API_BASE wins when both are present.
# SAVETABS_API_BASE=https://api.savetabs.example

# --- Web build (Vite) ---
VITE_API_BASE=https://api.savetabs.example

# --- Release script (scripts/update-versions.mjs) ---
# Optional. Defaults to https://savetabs.pages.dev/releases/<version>.
SAVETABS_NOTES_URL=https://savetabs.pages.dev/releases/0.1.0

# --- Worker runtime vars ---
# Source of truth is apps/worker/wrangler.toml [vars]; listed for reference.
WEB_ORIGIN=https://savetabs.pages.dev
GLOBAL_DAILY_REQUESTS=100000
GLOBAL_MAX_KEYS=10000

# --- Cloudflare deploy (GitHub Actions secrets; leave empty locally) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Browser store submission (GitHub Actions secrets; leave empty locally) ---
CHROME_EXTENSION_ID=
CHROME_CLIENT_ID=
CHROME_CLIENT_SECRET=
CHROME_REFRESH_TOKEN=
FIREFOX_JWT_ISSUER=
FIREFOX_JWT_SECRET=
