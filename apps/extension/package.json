{
  "name": "@savetabs/extension",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "icons": "node ../../scripts/generate-icons.mjs",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "build:safari": "wxt build -b safari",
    "safari:convert": "xcrun safari-web-extension-converter .output/safari-mv3 --project-location .output/safari-project --app-name SaveTabs --bundle-identifier com.azcom.savetabs --force",
    "verify:build": "node ../../scripts/verify-build.mjs",
    "screenshots": "node scripts/store-screenshots.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@savetabs/shared": "workspace:*",
    "lucide-react": "^1.68.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wxt": "^0.21.5"
  }
}
